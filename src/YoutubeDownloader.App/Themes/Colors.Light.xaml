<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Paleta clara: mesmos papéis da escura, contraste AA para texto. -->
    <Color x:Key="Color.Background">#F4F5F7</Color>
    <Color x:Key="Color.Sidebar">#ECEEF1</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.SurfaceRaised">#F0F2F5</Color>
    <Color x:Key="Color.Border">#DFE2E8</Color>
    <Color x:Key="Color.Track">#E2E5EA</Color>
    <Color x:Key="Color.TextPrimary">#15181D</Color>
    <Color x:Key="Color.TextSecondary">#465060</Color>
    <Color x:Key="Color.TextMuted">#717B8B</Color>
    <Color x:Key="Color.Accent">#2F62DD</Color>
    <Color x:Key="Color.AccentSubtle">#E2EAFD</Color>
    <Color x:Key="Color.AccentMuted">#9DB4EE</Color>
    <Color x:Key="Color.Warning">#A9670A</Color>
    <Color x:Key="Color.Danger">#C93636</Color>
    <Color x:Key="Color.Success">#17834F</Color>
    <Color x:Key="Color.Shadow">#1A2333</Color>

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Sidebar" Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.SurfaceRaised" Color="{StaticResource Color.SurfaceRaised}" />
    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Track" Color="{StaticResource Color.Track}" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="{StaticResource Color.TextPrimary}" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="{StaticResource Color.TextSecondary}" />
    <SolidColorBrush x:Key="Brush.TextMuted" Color="{StaticResource Color.TextMuted}" />
    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.AccentSubtle" Color="{StaticResource Color.AccentSubtle}" />
    <SolidColorBrush x:Key="Brush.AccentMuted" Color="{StaticResource Color.AccentMuted}" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#4A78E8" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#2552C0" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Warning" Color="{StaticResource Color.Warning}" />
    <SolidColorBrush x:Key="Brush.Danger" Color="{StaticResource Color.Danger}" />
    <SolidColorBrush x:Key="Brush.Success" Color="{StaticResource Color.Success}" />
    <SolidColorBrush x:Key="Brush.Input" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Scrim" Color="#801A2333" />
    <DropShadowEffect x:Key="Shadow.Drawer" BlurRadius="24" ShadowDepth="2" Opacity="0.16" Color="{StaticResource Color.Shadow}" />

    <SolidColorBrush x:Key="Brush.Kind.Video" Color="#2F62DD" />
    <SolidColorBrush x:Key="Brush.Kind.Audio" Color="#14918C" />
</ResourceDictionary>
