<Application x:Class="YoutubeDownloader.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:YoutubeDownloader.App.Converters"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- A paleta (primeiro dicionário) é trocada no início conforme a preferência de tema. -->
                <ResourceDictionary Source="Themes/Colors.Dark.xaml" />
                <ResourceDictionary Source="Themes/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <conv:BoolToVisibilityConverter x:Key="Visible" />
            <conv:BoolToVisibilityConverter x:Key="Hidden" Invert="True" />
            <conv:InverseBoolConverter x:Key="InverseBool" />
            <conv:UrlToImageConverter x:Key="Thumbnail" DecodeWidth="416" />
            <conv:UrlToImageConverter x:Key="SmallThumbnail" DecodeWidth="192" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
