<Project>
  <PropertyGroup>
    <Version>2.0.0</Version>
    <Product>YouTube Downloader</Product>
    <Authors>Wendel4444</Authors>
    <Copyright>Copyright (c) 2026 Wendel4444 · Licença MIT</Copyright>
    <Description>Baixa vídeos e áudios do YouTube e de outros sites com yt-dlp e FFmpeg.</Description>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <DebugType Condition="'$(Configuration)' == 'Release'">embedded</DebugType>
  </PropertyGroup>
</Project>
