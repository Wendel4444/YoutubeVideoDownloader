<Window x:Class="YtDownloader.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Downloader de Assets" Height="480" Width="550"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize">

    <!-- Fundo Preto e Roxo Gradiente -->
    <Window.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F0F0F" Offset="0.0"/>
            <!-- Preto -->
            <GradientStop Color="#20003B" Offset="0.5"/>
            <!-- Roxo Escuro -->
            <GradientStop Color="#5A189A" Offset="1.0"/>
            <!-- Roxo Vibrante -->
        </LinearGradientBrush>
    </Window.Background>

    <Grid Margin="30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Título -->
            <RowDefinition Height="Auto"/>
            <!-- Input -->
            <RowDefinition Height="Auto"/>
            <!-- Pasta de destino -->
            <RowDefinition Height="Auto"/>
            <!-- Opções -->
            <RowDefinition Height="Auto"/>
            <!-- Botão -->
            <RowDefinition Height="Auto"/>
            <!-- Barra de progresso -->
            <RowDefinition Height="*"/>
            <!-- Status -->
        </Grid.RowDefinitions>

        <!-- Título -->
        <TextBlock Grid.Row="0" Text="YOUTUBE DOWNLOADER" Foreground="White" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,25" />

        <!-- Input de Link com Borda Roxa e Cantos Arredondados -->
        <Border Grid.Row="1" Background="#1A1A1A" CornerRadius="8" Height="40" Margin="10,0" BorderBrush="#7B2CBF" BorderThickness="2">
            <TextBox x:Name="TxtUrl" Background="Transparent" Foreground="White" BorderThickness="0"
                     VerticalContentAlignment="Center" FontSize="14" Padding="10,0,10,0"
                     CaretBrush="#E0B0FF" />
        </Border>

        <!-- Pasta de destino -->
        <Grid Grid.Row="2" Margin="10,15,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#1A1A1A" CornerRadius="8" Height="38" Margin="0,0,10,0" BorderBrush="#7B2CBF" BorderThickness="2">
                <TextBlock x:Name="TxtFolder" Foreground="White" FontSize="13" Margin="10,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
            </Border>

            <Button x:Name="BtnChooseFolder" Grid.Column="1" Width="90" Height="38" Cursor="Hand" Click="BtnChooseFolder_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#3C0A6B" CornerRadius="8">
                            <TextBlock Text="Escolher..." Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>

        <!-- Opções -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,20">
            <RadioButton x:Name="RbVideo" Content="Vídeo (MP4)" IsChecked="True" Foreground="White" FontSize="15" Margin="0,0,30,0"/>
            <RadioButton x:Name="RbAudio" Content="Áudio (MP3)" Foreground="White" FontSize="15"/>
        </StackPanel>

        <!-- Botão Arredondado Roxo -->
        <Button x:Name="BtnDownload" Grid.Row="4" Width="200" Height="45" Cursor="Hand" Click="BtnDownload_Click" HorizontalAlignment="Center">
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <Border Background="{TemplateBinding Background}" CornerRadius="22">
                        <TextBlock Text="INICIAR DOWNLOAD" Foreground="White" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </ControlTemplate>
            </Button.Template>
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Background" Value="#7B2CBF"/>
                    <Style.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="#4A4A4A"/>
                        </Trigger>
                    </Style.Triggers>
                </Style>
            </Button.Style>
        </Button>

        <!-- Barra de Progresso -->
        <Border Grid.Row="5" Background="#1A1A1A" CornerRadius="6" Height="14" Margin="10,20,10,0" BorderBrush="#7B2CBF" BorderThickness="1">
            <ProgressBar x:Name="PbProgress" Minimum="0" Maximum="100" Value="0" Background="Transparent" BorderThickness="0" Foreground="#B44BFF"/>
        </Border>

        <!-- Status -->
        <TextBlock x:Name="TxtStatus" Grid.Row="6" Foreground="#E0B0FF" FontSize="14"
                   VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,15,0,0"/>
    </Grid>
</Window>